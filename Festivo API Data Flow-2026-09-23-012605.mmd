graph TD
    subgraph ClientLayer [Capa de Cliente]
        Client[Cliente Web / Móvil / Postman / Swagger UI]
    end

    subgraph PresentationLayer [Capa de Presentación / API]
        Index[index.js / app.js]
        Routes[Rutas Express<br/><i>festivo.rutas.js</i>]
        Validators[Middlewares / Validadores<br/><i>festivo.validador.js</i>]
    end

    subgraph BusinessLayer [Capa de Lógica de Negocio]
        Controllers[Controladores<br/><i>festivo.controlador.js</i><br/>Cálculos de Pascua y Ley Puente]
    end

    subgraph DataAccessLayer [Capa de Acceso a Datos]
        Repositories[Repositorios / Modelos<br/><i>festivo.repositorio.js</i>]
    end

    subgraph PersistenceLayer [Capa de Persistencia]
        DB[(Base de Datos MongoDB)]
    end

    Client -->|1. Petición HTTP GET| Index
    Index -->|2. Delega a| Routes
    Routes -->|3. Valida formato de fecha| Validators
    Validators -->|4. Pasa filtro| Controllers
    Controllers -->|5. Solicita lista de festivos| Repositories
    Repositories -->|6. Consulta| DB

    DB -.->|7. Retorna datos base| Repositories
    Repositories -.->|8. Procesa resultado / Aplica fórmulas| Controllers
    Controllers -.->|9. Respuesta JSON| Client

