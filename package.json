{
  "name": "api-festivos-colombia",
  "version": "1.0.0",
  "description": "API RESTful en Express.js y MongoDB para consulta de días festivos en Colombia - Taller 1 ITM",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "start:memory": "node src/index.memory.js",
    "dev": "node --watch src/index.js",
    "dev:memory": "node --watch src/index.memory.js",
    "seed": "node src/scripts/seed.js",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage --runInBand --forceExit"
  },
  "keywords": [
    "festivos",
    "colombia",
    "express",
    "mongodb",
    "mongoose",
    "ley-emiliani",
    "pascua"
  ],
  "author": "ITM - Arquitectura de Software II",
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.8.4",
    "swagger-ui-express": "^5.0.1",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^10.1.2",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  }
}
